# ── 基础配置 ──────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/gateway.sqlite3
SITE_NAME=Yu Gateway

# ── 域名配置（三套视角）────────────────────────────────────────────────────────
# 官网（Yu Gateway 公开页面）：www.yourdomain.com
# 用户后台（New API）：app.yourdomain.com
# API 调用地址：api.yourdomain.com

# 用户调用 API 的 base_url（显示在文档页面）
PUBLIC_API_BASE=https://api.yourdomain.com

# New API 用户后台（注册、登录、充值、Key 管理）
APP_BASE_URL=https://app.yourdomain.com
LOGIN_URL=https://app.yourdomain.com/login
REGISTER_URL=https://app.yourdomain.com/register

# New API 管理员后台（只有你知道的地址）
ADMIN_CONSOLE_URL=https://app.yourdomain.com/admin
NEWAPI_BASE_URL=https://app.yourdomain.com

# CORS：如果前端和 API 在同一域可以设为 *，生产建议只允许自己的域名
CORS_ALLOW_ORIGIN=*

# ── 安全配置（上线前必须修改！）──────────────────────────────────────────────
# 生成方法：python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=replace-with-a-long-random-token

# 只允许默认 ADMIN_TOKEN 在 localhost 开发环境打开后台；生产建议保持 false
ALLOW_DEFAULT_ADMIN_ON_LOCALHOST=false

# ── 计费配置 ───────────────────────────────────────────────────────────────────
BILLING_CURRENCY=CNY
BILLING_SYMBOL=¥
MIN_RECHARGE_AMOUNT=10

# ── 当前主力上游：chhai（token.chhai.cn）────────────────────────────────────
# 注册地址：https://token.chhai.cn  |  覆盖 GPT-4o / Claude / Gemini
CHHAI_API_KEY=

# ── 御三家直连 API Key（有官方账号时填入，可选）────────────────────────────────
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── 聚合商 API Key（推荐先用这个，一个账号覆盖御三家）──────────────────────────
# PoloAPI（gpt-4o / claude-sonnet / gemini 全有）: https://poloai.top
POLOAPI_API_KEY=

# weelinking（备用聚合商）: https://api.weelinking.com
WEELINKING_API_KEY=

# ── 其他上游 API Key（按需填入）──────────────────────────────────────────────
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
APIMART_API_KEY=
JIEKOU_API_KEY=
RIGHTCODE_API_KEY=

# ── 运行参数 ───────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=90
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10

# 演示门户 — 本地开发设 true 可预览用户后台，生产必须设 false
# false = /dashboard /recharge /keys /usage 全部跳转到 APP_BASE_URL
DEMO_PORTAL_ENABLED=false

# 种子演示数据（初次启动后建议关掉）
SEED_DEMO_DATA=false

# 是否保存 prompt 摘要到日志（隐私敏感，默认关闭）
SAVE_PROMPT_EXCERPT=false
